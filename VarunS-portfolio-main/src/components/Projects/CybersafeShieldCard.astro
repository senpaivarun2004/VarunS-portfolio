---
// CybersafeShieldCard.astro
import { StatCounter } from "../StatCounter";
---

<div class="relative w-full bg-bg-surface border border-border rounded-xl p-6 sm:p-8 hover:border-emerald-500/80 hover:shadow-[0_0_40px_rgba(16,185,129,0.15)] transition-all duration-300 group overflow-hidden">
  <!-- Subtle cyber texture -->
  <div class="absolute inset-0 opacity-[0.02] bg-[radial-gradient(#10b981_1px,transparent_1px)] [background-size:16px_16px] pointer-events-none"></div>

  <!-- Ambient glow that fades in on hover -->
  <div class="absolute -inset-px bg-gradient-to-r from-emerald-500/10 via-transparent to-accent-cyan/10 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none z-0"></div>

  <div class="relative z-10 flex flex-col justify-between h-full space-y-6">
    <!-- Header -->
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="text-2xl sm:text-3xl font-sans font-bold text-white tracking-tight">Cybersafe Shield</span>
        <span class="px-2.5 py-0.5 font-mono text-[10px] bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 rounded-md font-bold">
          COMPLETED
        </span>
      </div>
      <div class="flex items-center gap-1.5 px-3 py-1 bg-white/5 border border-white/10 rounded-full">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="font-mono text-[9px] uppercase tracking-wider text-text-secondary">Core Masterpiece · ML & Security</span>
      </div>
    </div>

    <!-- Core Description & Problem/Solution -->
    <div class="space-y-4 max-w-4xl font-sans text-sm sm:text-base text-text-secondary leading-relaxed">
      <p>
        Built a machine-learning and NLP-based cyberbullying detection system designed to identify abusive or harmful messages and promote safer online communication.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs font-mono pt-2">
        <div class="p-3.5 bg-black/60 border border-border/80 rounded-lg">
          <span class="text-emerald-400 font-bold uppercase tracking-wider block mb-1">Problem Addressed</span>
          <p class="text-text-secondary font-sans leading-normal">
            Detection of hostile text, abusive slurs, and cyberbullying across digital interaction channels where manual moderation cannot scale.
          </p>
        </div>
        <div class="p-3.5 bg-black/60 border border-border/80 rounded-lg">
          <span class="text-accent-cyan font-bold uppercase tracking-wider block mb-1">Engineered Solution</span>
          <p class="text-text-secondary font-sans leading-normal">
            End-to-end NLP text preprocessing pipeline with Support Vector Machine (SVM) classification, serialized model via Joblib, Flask API, and SQLite flagged repository.
          </p>
        </div>
      </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 py-2">
      <div class="bg-black/50 border border-border/60 rounded-lg p-3 text-center">
        <span class="text-white font-mono text-xl sm:text-2xl font-bold block">SVM</span>
        <span class="text-text-muted font-mono text-[10px] uppercase">Classifier Model</span>
      </div>
      <div class="bg-black/50 border border-border/60 rounded-lg p-3 text-center">
        <span class="text-emerald-400 font-mono text-xl sm:text-2xl font-bold block">NLP</span>
        <span class="text-text-muted font-mono text-[10px] uppercase">Text Preprocessing</span>
      </div>
      <div class="bg-black/50 border border-border/60 rounded-lg p-3 text-center">
        <span class="text-accent-cyan font-mono text-xl sm:text-2xl font-bold block">Flask</span>
        <span class="text-text-muted font-mono text-[10px] uppercase">REST Inference API</span>
      </div>
      <div class="bg-black/50 border border-border/60 rounded-lg p-3 text-center">
        <span class="text-purple-400 font-mono text-xl sm:text-2xl font-bold block">SQLite</span>
        <span class="text-text-muted font-mono text-[10px] uppercase">Flagged Audit DB</span>
      </div>
    </div>

    <!-- Tags Row -->
    <div class="flex flex-wrap gap-2 select-none">
      <span class="px-2.5 py-1 bg-bg-elevated border border-border text-text-secondary rounded-md font-mono text-[10px]">#Python</span>
      <span class="px-2.5 py-1 bg-bg-elevated border border-border text-text-secondary rounded-md font-mono text-[10px]">#Machine-Learning</span>
      <span class="px-2.5 py-1 bg-bg-elevated border border-border text-text-secondary rounded-md font-mono text-[10px]">#NLP</span>
      <span class="px-2.5 py-1 bg-bg-elevated border border-border text-text-secondary rounded-md font-mono text-[10px]">#Scikit-learn</span>
      <span class="px-2.5 py-1 bg-bg-elevated border border-border text-text-secondary rounded-md font-mono text-[10px]">#SVM</span>
      <span class="px-2.5 py-1 bg-bg-elevated border border-border text-text-secondary rounded-md font-mono text-[10px]">#Flask</span>
      <span class="px-2.5 py-1 bg-bg-elevated border border-border text-text-secondary rounded-md font-mono text-[10px]">#Cybersecurity</span>
    </div>

    <!-- Action Link -->
    <div class="flex items-center justify-between border-t border-border pt-5">
      <span class="font-mono text-xs text-text-muted">Repository: Project-on-Prevent-Cyber-Bulling-in-social-media</span>
      <a 
        href="https://github.com/senpaivarun2004/Project-on-Prevent-Cyber-Bulling-in-social-media" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center gap-2 px-5 py-2.5 bg-accent-cyan text-black font-mono font-bold text-xs rounded-lg hover:bg-accent-cyan/90 transition-all shadow-md"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
        </svg>
        <span>View on GitHub ↗</span>
      </a>
    </div>
  </div>
</div>
