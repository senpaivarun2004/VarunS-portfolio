---
// AnalyticsWorkflow.astro
const workflowSteps = [
  {
    step: "01",
    title: "Raw Data",
    tech: "CSV, Excel, APIs, DBs",
    desc: "Ingesting heterogeneous datasets and business logs"
  },
  {
    step: "02",
    title: "Data Cleaning",
    tech: "Power Query, Pandas",
    desc: "Handling nulls, duplicates, typing & validation"
  },
  {
    step: "03",
    title: "Exploratory EDA",
    tech: "Seaborn, Matplotlib, SQL",
    desc: "Uncovering distributions, outliers & anomalies"
  },
  {
    step: "04",
    title: "Transformation",
    tech: "DAX Measures, Feature Scaling",
    desc: "Structuring KPIs, ratios & relational modeling"
  },
  {
    step: "05",
    title: "SQL / Python Engine",
    tech: "Window Functions, Scikit-learn",
    desc: "Executing complex queries & ML pipelines"
  },
  {
    step: "06",
    title: "Interactive BI",
    tech: "Power BI, Slicers, Dashboards",
    desc: "Visual storytelling with drill-through views"
  },
  {
    step: "07",
    title: "Decision Making",
    tech: "Executive KPIs",
    desc: "Translating data insights into business actions"
  }
];
---

<section id="workflow" class="py-24 px-6 md:px-12 bg-black border-t border-border relative select-none">
  <div class="max-w-6xl mx-auto space-y-12">
    <!-- Header -->
    <div class="fade-in-up flex items-center gap-2">
      <span class="font-mono text-xs text-accent-cyan">// 02.</span>
      <h2 class="text-xs uppercase tracking-widest text-text-muted font-mono font-bold">Analytics Architecture</h2>
    </div>

    <div class="fade-in-up max-w-3xl space-y-3">
      <h3 class="text-2xl sm:text-3xl font-sans font-bold text-white tracking-tight">
        End-to-End Analytics &amp; Intelligence Pipeline
      </h3>
      <p class="font-sans text-sm text-text-secondary leading-relaxed font-normal">
        From unstructured transactional records to strategic executive intelligence, every project follows a disciplined engineering workflow.
      </p>
    </div>

    <!-- Stepper Pipeline Layout -->
    <div class="fade-in-up grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 pt-4">
      {workflowSteps.map((s, index) => (
        <div class="relative bg-bg-surface border border-border hover:border-accent-cyan/50 rounded-xl p-5 transition-all duration-200 group flex flex-col justify-between shadow-sm">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="font-mono text-xs font-bold text-accent-cyan px-2 py-0.5 rounded bg-accent-cyan/10 border border-accent-cyan/20">
                STAGE {s.step}
              </span>
              {index < workflowSteps.length - 1 && (
                <span class="text-text-muted text-xs font-mono group-hover:text-accent-cyan transition-colors">→</span>
              )}
            </div>
            <h4 class="font-sans text-base font-bold text-white tracking-tight mb-1 group-hover:text-accent-cyan transition-colors">
              {s.title}
            </h4>
            <p class="font-sans text-xs text-text-secondary leading-relaxed font-normal mb-3">
              {s.desc}
            </p>
          </div>
          <div class="pt-3 border-t border-border/50">
            <span class="text-[10px] font-mono text-text-muted uppercase tracking-wider block">Stack:</span>
            <span class="text-xs font-mono text-white/90">{s.tech}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
