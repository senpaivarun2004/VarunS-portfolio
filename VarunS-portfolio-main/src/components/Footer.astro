---
// Footer.astro
import { LoopingWords } from "./LoopingWords";

const footerWords = [
  "VARUN S",
  "Data Analytics",
  "Applied AI",
  "Cybersecurity",
  "Power BI Developer",
  "Bangalore, India"
];
---

<footer class="py-16 px-6 md:px-12 bg-black border-t border-border select-none">
  <div class="max-w-6xl mx-auto space-y-12">
    <!-- Looping Words signature sign-off -->
    <div class="flex justify-center border-b border-border/30 pb-12">
      <LoopingWords client:load words={footerWords} />
    </div>

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-8 pt-4">
      <!-- Brand & Copyright -->
      <div class="space-y-1">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-accent-cyan shadow-[0_0_8px_#00d8ff]"></span>
          <span class="font-mono text-base font-bold text-white tracking-wide block">
            VARUN S
          </span>
          <span class="text-xs text-text-muted font-mono">· Data + AI + Analytics + Security</span>
        </div>
        <p class="font-sans text-xs text-text-secondary">
          &copy; 2026 Varun S. Soundarya Institute (BCA) &amp; Imarticus Learning (PGDM).
        </p>
      </div>

      <!-- Quick social links -->
      <div class="flex flex-wrap items-center gap-6 font-mono text-xs text-text-secondary">
        <a href="https://github.com/senpaivarun2004" target="_blank" rel="noopener noreferrer" class="hover:text-accent-cyan transition-colors">GitHub</a>
        <a href="https://www.linkedin.com/in/varun-s-95b7b8252" target="_blank" rel="noopener noreferrer" class="hover:text-accent-cyan transition-colors">LinkedIn</a>
        <a href="https://www.hackerrank.com/profile/senpaivarun" target="_blank" rel="noopener noreferrer" class="hover:text-accent-cyan transition-colors">HackerRank</a>
        <a href="#hero" class="hover:text-white transition-colors">↑ Top</a>
      </div>
    </div>
  </div>
</footer>
