---
// Hero.astro
import { InteractiveGridBackground } from "./InteractiveGridBackground";
import { LoopingWords } from "./LoopingWords";
import { DynamicRepoStat } from "./DynamicRepoStat";

const heroWords = [
  "Data Analytics",
  "Applied AI",
  "Cybersecurity",
  "Power BI & DAX",
  "Ethical Hacking",
  "SQL & Python"
];
---

<section id="hero" class="relative min-h-screen bg-black overflow-hidden select-none flex flex-col justify-center">
  <InteractiveGridBackground client:idle className="min-h-screen w-full flex flex-col justify-center items-center py-24 px-6 relative" fadeIntensity={25}>
    <!-- Cyberpunk ambient radial gradient -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] md:w-[900px] md:h-[900px] pointer-events-none z-0">
      <div class="w-full h-full bg-[radial-gradient(circle,rgba(0,216,255,0.09)_0%,rgba(168,85,247,0.04)_40%,rgba(0,0,0,0)_75%)] rounded-full pulse-glow-bg"></div>
    </div>

    <div class="max-w-4xl mx-auto flex flex-col items-center text-center z-10 relative">
      <!-- Badge pill -->
      <div class="fade-in-up inline-flex items-center gap-2 px-3.5 py-1.5 bg-bg-surface border border-border hover:border-accent-cyan/40 transition-colors rounded-full mb-6 shadow-lg backdrop-blur-sm">
        <span class="w-2 h-2 rounded-full bg-accent-cyan animate-ping"></span>
        <span class="font-mono text-xs text-text-secondary tracking-wide uppercase">
          BCA Graduate &middot; PGDM Graduate · Bangalore, India
        </span>
      </div>

      <!-- Main headline -->
      <h1 class="text-[clamp(2.4rem,7vw,5rem)] font-sans font-bold leading-[1.08] tracking-[-0.03em] text-white max-w-4xl mb-4">
        Turning Data Into
        <span class="block text-transparent bg-clip-text bg-gradient-to-r from-accent-cyan via-white to-purple-400">
          Intelligence.
        </span>
      </h1>

      <!-- Looping words dynamic cycle -->
      <div class="fade-in-up w-full max-w-xl mx-auto mb-6 flex justify-center">
        <LoopingWords client:load words={heroWords} />
      </div>

      <!-- Subtitle Tagline -->
      <p class="fade-in-up text-base sm:text-lg md:text-xl font-sans text-text-secondary max-w-2xl mb-8 leading-relaxed font-normal">
        Turning data into insights. Building intelligent solutions. Exploring the intersection of Data Analytics, Machine Learning, and Cybersecurity.
      </p>

      <!-- Animated terminal element -->
      <div class="fade-in-up w-full max-w-md mx-auto mb-10 bg-bg-surface/90 border border-border/80 rounded-lg p-3 text-left font-mono text-xs text-text-secondary shadow-2xl relative overflow-hidden backdrop-blur-md">
        <div class="flex items-center gap-1.5 pb-2 border-b border-border/50 mb-2">
          <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-green-500/80"></span>
          <span class="text-[10px] text-text-muted ml-2">varun@analytics-sec:~$</span>
        </div>
        <div id="terminal-lines" class="space-y-1 text-[11px]">
          <p class="text-accent-cyan/90">&gt; analyzing_data... <span class="text-white/60">[SQL / Power BI / Pandas]</span></p>
          <p class="text-purple-400/90">&gt; training_model... <span class="text-white/60">[SVM / Scikit-learn]</span></p>
          <p class="text-emerald-400/90">&gt; detecting_patterns... <span class="text-white/60">[NLP / Anomaly Risk]</span></p>
          <p class="text-white font-medium flex items-center gap-1">
            <span class="text-accent-cyan">&gt; system_ready_</span>
            <span class="inline-block w-2 h-3.5 bg-accent-cyan animate-pulse"></span>
          </p>
        </div>
      </div>

      <!-- CTA Buttons Row -->
      <div class="fade-in-up flex flex-wrap gap-3.5 mb-14 justify-center w-full sm:w-auto">
        <a href="#projects" class="px-6 py-3 bg-white text-black font-sans font-medium rounded-full hover:bg-white/90 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 shadow-[0_4px_25px_rgba(255,255,255,0.2)] flex items-center justify-center gap-2 group text-sm">
          <span>View My Projects</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="group-hover:translate-x-1 transition-transform duration-200"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
        <a href="https://github.com/senpaivarun2004" target="_blank" rel="noopener noreferrer" class="px-6 py-3 border border-border bg-bg-surface text-white font-sans font-medium rounded-full hover:bg-bg-elevated hover:border-accent-cyan/40 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 flex items-center justify-center gap-2 text-sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
          </svg>
          <span>GitHub</span>
        </a>
        <a href="#contact" class="px-6 py-3 border border-border bg-bg-surface text-text-secondary hover:text-white font-sans font-medium rounded-full hover:bg-bg-elevated hover:border-white/20 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 flex items-center justify-center gap-2 text-sm">
          <span>Contact Me</span>
        </a>
      </div>

      <!-- Verified GitHub Statistics Row -->
      <div class="fade-in-up w-full max-w-2xl border-t border-b border-border/80 py-5 grid grid-cols-2 md:grid-cols-4 gap-4 select-none bg-black/40 backdrop-blur-sm rounded-lg">
        <DynamicRepoStat client:load />
        <div class="flex flex-col items-center px-4 border-l border-border/60">
          <span class="font-mono text-2xl md:text-3xl font-bold text-accent-cyan tracking-tight">BCA '25</span>
          <span class="font-mono text-[10px] text-text-muted uppercase tracking-wider mt-1">Graduate</span>
        </div>
        <div class="flex flex-col items-center px-4 border-t border-border/60 pt-3 md:pt-0 md:border-t-0 md:border-l md:border-border/60">
          <span class="font-mono text-2xl md:text-3xl font-bold text-purple-400 tracking-tight">PGDM '26</span>
          <span class="font-mono text-[10px] text-text-muted uppercase tracking-wider mt-1">Completed</span>
        </div>
        <div class="flex flex-col items-center px-4 border-t border-border/60 pt-3 md:pt-0 md:border-t-0 border-l border-border/60">
          <span class="font-mono text-2xl md:text-3xl font-bold text-emerald-400 tracking-tight">4+</span>
          <span class="font-mono text-[10px] text-text-muted uppercase tracking-wider mt-1">Domain Pillars</span>
        </div>
      </div>
    </div>
  </InteractiveGridBackground>
</section>
